{
  "info": {
    "name": "Devsphere API - Test",
    "_postman_id": "devesphere-collection-001",
    "description": "Collection to test Devsphere user, team and project endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/register",
          "host": ["{{baseUrl}}"],
          "path": ["api","users","register"]
        }
      },
      "response": []
    },
    {
      "name": "Auth - Login (set token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if(json.token){",
              "    pm.environment.set('token', json.token);",
              "    if(json.id) pm.environment.set('userId', json.id);",
              "}",
              "else if (json.user && json.user.token){",
              "    pm.environment.set('token', json.user.token);",
              "    if(json.user.id) pm.environment.set('userId', json.user.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/login",
          "host": ["{{baseUrl}}"],
          "path": ["api","users","login"]
        }
      },
      "response": []
    },
    {
      "name": "Create Team",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alpha Team\",\n  \"description\": \"Team for alpha projects\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/teams",
          "host": ["{{baseUrl}}"],
          "path": ["api","teams"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if(json._id) pm.environment.set('teamId', json._id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get My Teams",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/teams/my",
          "host": ["{{baseUrl}}"],
          "path": ["{{baseUrl}}","api","teams","my"]
        }
      },
      "response": []
    },
    {
      "name": "Create Project (no team)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Project Solo\",\n  \"description\": \"A project with no initial team\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects",
          "host": ["{{baseUrl}}"],
          "path": ["api","projects"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if(json._id) pm.environment.set('projectId', json._id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Create Project (under team)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Project Team A\",\n  \"description\": \"A project created under a team\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/team/{{teamId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api","projects","team","{{teamId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if(json._id) pm.environment.set('projectId', json._id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get My Projects",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/projects",
          "host": ["{{baseUrl}}"],
          "path": ["api","projects"]
        }
      },
      "response": []
    },
    {
      "name": "Get Project By Id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api","projects","{{projectId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Update Project",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Project Solo - Updated\",\n  \"description\": \"Updated description\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api","projects","{{projectId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Assign Team to Project",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teamId\": \"{{teamId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/assign-team",
          "host": ["{{baseUrl}}"],
          "path": ["api","projects","{{projectId}}","assign-team"]
        }
      },
      "response": []
    },
    {
      "name": "Remove Team from Project",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teamId\": \"{{teamId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/remove-team",
          "host": ["{{baseUrl}}"],
          "path": ["api","projects","{{projectId}}","remove-team"]
        }
      },
      "response": []
    },
    {
      "name": "Link Repo to Project",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider\": \"github\",\n  \"repoOwner\": \"org-or-user\",\n  \"repoName\": \"repo-name\",\n  \"repoUrl\": \"https://github.com/org-or-user/repo-name\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/link",
          "host": ["{{baseUrl}}"],
          "path": ["api","projects","{{projectId}}","link"]
        }
      },
      "response": []
    },
    {
      "name": "Delete Project",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api","projects","{{projectId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Add Member to Team",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"anotheruser@example.com\",\n  \"role\": \"developer\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/teams/{{teamId}}/members",
          "host": ["{{baseUrl}}"],
          "path": ["api","teams","{{teamId}}","members"]
        }
      },
      "response": []
    }
  ],
  "event": [],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "teamId", "value": "" },
    { "key": "projectId", "value": "" }
  ]
}
